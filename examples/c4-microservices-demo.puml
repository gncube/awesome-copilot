@startuml Aspire-Microservices-Architecture
' ============================================================
' Aspire Orchestration Microservices Architecture
' Following tupadr3/plantuml-icon-font-sprites pattern
' Domain-driven design with multiple service boundaries
' ============================================================

skinparam defaultTextAlignment center

!$ICONURL = "https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/v3.0.0/icons"
!include $ICONURL/common.puml
!include $ICONURL/font-awesome-5/mobile_alt.puml
!include $ICONURL/font-awesome-5/desktop.puml
!include $ICONURL/font-awesome-5/exchange_alt.puml
!include $ICONURL/font-awesome-5/shield_alt.puml
!include $ICONURL/font-awesome-5/shopping_cart.puml
!include $ICONURL/font-awesome-5/boxes.puml
!include $ICONURL/font-awesome-5/envelope.puml
!include $ICONURL/font-awesome-5/database.puml
!include $ICONURL/font-awesome-5/cogs.puml
!include $ICONURL/devicons/redis.puml
!include $ICONURL/devicons/postgresql.puml
!include $ICONURL/font-awesome-5/cube.puml
!include $ICONURL/font-awesome-5/comments.puml

' ----------------------------------------------------------
' CLIENT APPLICATIONS (Left Side)
' ----------------------------------------------------------
FA5_MOBILE_ALT(mobileApp, "Mobile App", node) #Purple
FA5_DESKTOP(browserApp, "Browser", node) #Purple

' ----------------------------------------------------------
' CLOUD SERVICES (Aspire Orchestration - Main Platform)
' ----------------------------------------------------------
FA5_CUBE(aspireOrch, "Aspire Orchestration", node) #Cyan {

    ' ========== BACKEND FOR FRONTEND (BFF) LAYER ==========
    FA5_EXCHANGE_ALT(mobileBFF, "Mobile BFF", node) #Blue {
        FA5_COGS(mobileAPI, "Mobile API", node) #Blue
    }

    ' ========== WEB LAYER ==========
    FA5_CUBE(webApp, "Web App", node) #Blue {
        FA5_COGS(blazorApp, "Blazor App", node) #Blue
    }

    ' ========== MICROSERVICES LAYER ==========

    ' Identity Service Domain
    FA5_SHIELD_ALT(identityService, "Identity Service", node) #DarkBlue {
        FA5_COGS(identityAPI, "Identity API", node) #DarkBlue
        DEV_POSTGRESQL(identityDb, "PostgreSQL", node) #DarkBlue
    }

    ' Catalog Service Domain
    FA5_BOXES(catalogService, "Catalog Service", node) #DarkGreen {
        FA5_COGS(catalogAPI, "Catalog API", node) #DarkGreen
        DEV_POSTGRESQL(catalogDb, "PostgreSQL", node) #DarkGreen
    }

    ' Order Service Domain
    FA5_SHOPPING_CART(orderService, "Order Service", node) #Orange {
        FA5_COGS(orderingAPI, "Ordering API", node) #Orange
        FA5_COGS(orderProcessor, "Order Processor", node) #Orange
        DEV_POSTGRESQL(orderDb, "PostgreSQL", node) #Orange
    }

    ' Basket Service Domain
    FA5_COMMENTS(basketService, "Basket Service", node) #Red {
        FA5_COGS(basketAPI, "Basket API", node) #Red
        DEV_REDIS(basketCache, "Redis", node) #Red
    }

    ' Payment Service Domain
    FA5_COGS(paymentService, "Payment Service", node) #Yellow {
        FA5_COGS(paymentProcessor, "Payment Processor", node) #Yellow
    }

    ' Event Bus (Central Messaging)
    FA5_COMMENTS(eventBus, "Event Bus", node) #Orange

    ' Admin Services
    FA5_COGS(adminServices, "Admin Services", node) #Purple {
        FA5_COGS(webhooksAPI, "Webhooks API", node) #Purple
        DEV_POSTGRESQL(webhooksDb, "PostgreSQL", node) #Purple
    }
}

' ----------------------------------------------------------
' EXTERNAL SERVICES (Right Side)
' ----------------------------------------------------------
FA5_COGS(openai, "OpenAI", node) #Cyan
FA5_COGS(observability, "Observability", node) #Green

' ----------------------------------------------------------
' EXTERNAL CLIENTS
' ----------------------------------------------------------
FA5_ENVELOPE(webhookClient, "Webhook Client", node) #Gray

' ----------------------------------------------------------
' RELATIONSHIPS: CLIENT → BFF/WEB APP
' ----------------------------------------------------------
mobileApp --> mobileAPI : calls
browserApp --> blazorApp : loads

' ----------------------------------------------------------
' RELATIONSHIPS: BFF/WEB → MICROSERVICES
' ----------------------------------------------------------
mobileAPI --> identityAPI : auth
mobileAPI --> catalogAPI : products
mobileAPI --> orderingAPI : orders
mobileAPI --> basketAPI : cart

blazorApp --> identityAPI : auth
blazorApp --> catalogAPI : products
blazorApp --> orderingAPI : orders
blazorApp --> basketAPI : cart

' ----------------------------------------------------------
' RELATIONSHIPS: SERVICE → SERVICE (Inter-Service)
' ----------------------------------------------------------
orderingAPI --> catalogAPI : queries stock
orderingAPI --> basketAPI : gets cart
orderingAPI --> paymentProcessor : process payment
orderProcessor --> eventBus : publishes OrderCreated
basketAPI --> eventBus : publishes BasketCheckout

' ----------------------------------------------------------
' RELATIONSHIPS: SERVICE → DATABASE
' ----------------------------------------------------------
identityAPI --> identityDb : stores users
catalogAPI --> catalogDb : stores products
orderingAPI --> orderDb : stores orders
orderProcessor --> orderDb : updates orders
basketAPI --> basketCache : session cache
webhooksAPI --> webhooksDb : stores webhooks

' ----------------------------------------------------------
' RELATIONSHIPS: SERVICE → EVENT BUS
' ----------------------------------------------------------
orderingAPI --> eventBus : publishes
paymentProcessor --> eventBus : publishes
basketAPI --> eventBus : publishes

' ----------------------------------------------------------
' RELATIONSHIPS: EVENT BUS → CONSUMERS
' ----------------------------------------------------------
eventBus --> orderProcessor : consumes
eventBus --> webhooksAPI : consumes
eventBus --> observability : emits metrics

' ----------------------------------------------------------
' RELATIONSHIPS: EXTERNAL INTEGRATIONS
' ----------------------------------------------------------
catalogAPI --> openai : product descriptions
paymentProcessor --> openai : fraud detection
identityAPI --> observability : logs/traces
orderingAPI --> observability : logs/traces
webhookClient --> webhooksAPI : triggers

@enduml
