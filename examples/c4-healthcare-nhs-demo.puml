@startuml C4-Healthcare-NHS-Example
' ============================================================
' Example: C4 Component Diagram for Healthcare System
' Generated by: PlantUML Architect Agent
' Sprite Library: tupadr3/plantuml-icon-font-sprites v3.0.0
' Branding: NHS (UK National Health Service)
' Domain: Clinical Records Management System
' ============================================================

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

skinparam defaultTextAlignment center
LAYOUT_WITH_LEGEND()

' ----------------------------------------------------------
' NHS Branding Tags
' C4 diagrams use color/border tags for professional styling
' For icon-rich healthcare diagrams, use icon macros instead (see icon-sprites-*.puml)
' ----------------------------------------------------------
AddElementTag("nhs-clinical", $bgColor="#005EB8", $fontColor="#FFFFFF", $borderColor="#003087")
AddElementTag("nhs-security", $bgColor="#003087", $fontColor="#FFFFFF", $borderColor="#001F3F")
AddElementTag("nhs-data", $bgColor="#00758F", $fontColor="#FFFFFF", $borderColor="#005A6E")
AddElementTag("nhs-external", $bgColor="#6B7280", $fontColor="#FFFFFF", $borderColor="#4B5563")

' ----------------------------------------------------------
' External Systems (NHS Infrastructure)
' ----------------------------------------------------------
System_Ext(nhs111, "NHS 111 Online", "Triage and referral service", $tags="nhs-external")
System_Ext(nhs999, "NHS 999 Emergency", "Emergency dispatch", $tags="nhs-external")

' ----------------------------------------------------------
' System Boundary: Healthcare Platform (Azure)
' ----------------------------------------------------------
System_Boundary(healthcare, "Healthcare Platform") {

    ' ----------------------------------------------------------
    ' EHR Container
    ' ----------------------------------------------------------
    Container(electronicsHealthRecord, "EHR System", "FHIR-compliant",
        "Centralized patient health records.\nManages appointments, medications, diagnoses.",
        $tags="nhs-data")

    ' ----------------------------------------------------------
    ' Clinical Records API Container (Azure Functions)
    ' ----------------------------------------------------------
    Container_Boundary(clinicalApi, "Clinical Records API — Azure Functions (.NET)") {

        Component(authHandler, "Auth Handler (OIDC)", "Azure Function",
            "Authenticates clinicians via NHS login.\nEnforces role-based access control.",
            $tags="nhs-security")

        Component(patientMgmt, "Patient Management", "Azure Function",
            "CRUD for patient demographics.\nEnforces patient confidentiality flags.",
            $tags="nhs-clinical")

        Component(recordReader, "Record Reader", "Azure Function",
            "Retrieves patient medical history.\nLogs all access for audit trail.",
            $tags="nhs-clinical")

        Component(recordWriter, "Record Writer", "Azure Function",
            "Creates/updates clinical notes.\nVersions all changes for audit.",
            $tags="nhs-clinical")

        Component(consentValidator, "Consent Validator", "Azure Function",
            "Checks patient consent flags (GDPR).\nEnforces data sharing permissions.",
            $tags="nhs-security")

        Component(auditLogger, "Audit Logger", "Azure Function",
            "Records all clinical data access.\nRetains logs per HIPAA/NHS standards.",
            $tags="nhs-security")

        Component(dataAccess, "Data Access Layer", "EF Core Repository Pattern",
            "Abstracts database interactions.\nEnables encryption at rest.",
            $tags="nhs-data")
    }

    ' ----------------------------------------------------------
    ' Health Data Store Container
    ' ----------------------------------------------------------
    ContainerDb(healthDataDb, "Health Data Store", "PostgreSQL",
        "Encrypted patient records.\nComplies with GDPR Article 32.",
        $tags="nhs-data")
}

' ----------------------------------------------------------
' Relationships: EHR System → Components
' ----------------------------------------------------------
Rel(electronicsHealthRecord, patientMgmt, "synchronizes patient master data", "FHIR API")
Rel(electronicsHealthRecord, recordReader, "queries clinical records", "RESTful FHIR")

' ----------------------------------------------------------
' Relationships: Clinician Workflows
' ----------------------------------------------------------
Rel(authHandler, consentValidator, "validates user permissions", "internal")
Rel(recordReader, consentValidator, "checks read consent", "internal")
Rel(recordWriter, consentValidator, "checks write consent", "internal")

' ----------------------------------------------------------
' Relationships: Data Access
' ----------------------------------------------------------
Rel(patientMgmt, dataAccess, "persists demographics", "EF Core")
Rel(recordReader, dataAccess, "fetches clinical notes", "EF Core")
Rel(recordWriter, dataAccess, "writes clinical records", "EF Core")
Rel(dataAccess, healthDataDb, "encrypted read/write", "TDE/TCP:5432")

' ----------------------------------------------------------
' Relationships: Audit Trail
' ----------------------------------------------------------
Rel(recordReader, auditLogger, "logs access event", "async queue")
Rel(recordWriter, auditLogger, "logs change event", "async queue")
Rel(consentValidator, auditLogger, "logs permission check", "async queue")

' ----------------------------------------------------------
' Relationships: External NHS Services
' ----------------------------------------------------------
Rel(patientMgmt, nhs111, "queries referrals", "NHS HL7 gateway")
Rel(patientMgmt, nhs999, "alerts on emergencies", "NHS emergency dispatch")

SHOW_LEGEND()
@enduml
