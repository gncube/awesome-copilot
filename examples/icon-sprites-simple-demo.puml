@startuml Simple-Icon-Sprites-Example
' ============================================================
' Simple Icon Sprites Example
' Following tupadr3/plantuml-icon-font-sprites v3.0.0 pattern
' Using icon macros directly as diagram elements
' ============================================================

skinparam defaultTextAlignment center

!$ICONURL = "https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/v3.0.0/icons"
!include $ICONURL/common.puml
!include $ICONURL/devicons/mysql.puml
!include $ICONURL/font-awesome/server.puml
!include $ICONURL/font-awesome-5/database.puml

title Icon Sprites Styling Example

' ----------------------------------------------------------
' Icon Macros: <PREFIX>_<NAME>(alias, label, shape, color)
' ----------------------------------------------------------

' Font-Awesome 4 Server Icons
FA_SERVER(web1, WEB1) #Green
FA_SERVER(web2, WEB1) #Yellow
FA_SERVER(web3, WEB1) #Blue
FA_SERVER(web4, WEB1) #YellowGreen

' Font-Awesome 5 Database Icon
FA5_DATABASE(db1, LIVE, database, white) #RoyalBlue

' Devicons MySQL Icon
DEV_MYSQL(db2, SPARE, database) #Red

' ----------------------------------------------------------
' Relationships
' ----------------------------------------------------------

db1 <--> db2

web1 <--> db1
web2 <--> db1
web3 <--> db1
web4 <--> db1

@enduml
